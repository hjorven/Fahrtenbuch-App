# Vorlage für /etc/fahrtenbuch-display.env (install.sh legt die Datei an, Rechte 640).
# Echte Passwörter gehören nur in /etc/fahrtenbuch-display.env, nie ins Repo.
PB_URL=http://localhost:8090
PB_EMAIL=display@fahrtenbuch.local
PB_PASSWORD=
# Variante A (GPIO): /dev/serial0   Variante B (USB-Kabel): /dev/ttyUSB0
SERIAL_PORT=/dev/ttyUSB0
# Adresse, die das Display als Text und QR-Code für die Apps anzeigt
APP_URL=http://fahrtenbuch.local:8090
# Optional: 4-stellige PIN für das Server-Menü, leer = keine PIN
PIN=
TZ_NAME=Europe/Berlin
# Optional: Ordner mit der Backup-Kopie (z. B. USB-Stick). Das Display warnt, wenn er fehlt
# oder die neueste Datei älter als 2 Tage ist. Leer = nicht prüfen.
BACKUP_KOPIE=/mnt/backup/fahrtenbuch
# Optional: Bilddrehung 0 oder 180, wird bei jedem Start ans Display geschickt. Leer = Einstellung am Display.
DREHUNG=
# Optional: Ort für Wetter und Glättewarnung am Display als Breite,Länge (z. B. 53.55,9.99), auf ~1 km
# gerundet an Open-Meteo. Leer = kein Wetter, dann geht kein Ort nach außen.
WETTER_ORT=
